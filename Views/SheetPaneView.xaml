<UserControl x:Class="MiniEXEL.Views.SheetPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="500" d:DesignWidth="600">
    <Grid Background="{DynamicResource BgDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Formula bar: name box + editable content, like Excel -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" Background="{DynamicResource BgPanel}">
            <DockPanel>
                <TextBlock x:Name="TxtNameBox" DockPanel.Dock="Left" Text="" Width="60" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{DynamicResource TextSecondary}"/>
                <Border DockPanel.Dock="Left" Width="1" Background="{DynamicResource BorderSoft}" Margin="0,4"/>
                <TextBox x:Name="TxtFormulaBar" BorderThickness="0" Padding="8,6"
                         FontFamily="Consolas" Background="Transparent" Foreground="{DynamicResource TextPrimary}"
                         CaretBrush="{DynamicResource TextPrimary}"
                         Text="Selecciona una celda"
                         KeyDown="TxtFormulaBar_KeyDown"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="6,6,0,0">
                <Grid>
                    <DataGrid x:Name="GridWorkbook" AutoGenerateColumns="False" IsReadOnly="False"
                              HeadersVisibility="All" GridLinesVisibility="None"
                              RowBackground="White" AlternatingRowBackground="White"
                              SelectionUnit="Cell" SelectionMode="Extended"
                              ClipboardCopyMode="ExcludeHeader"
                              RowHeight="22" ColumnWidth="90" BorderThickness="0"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              CurrentCellChanged="GridWorkbook_CurrentCellChanged"
                              CellEditEnding="GridWorkbook_CellEditEnding"
                              PreviewKeyDown="GridWorkbook_PreviewKeyDown"
                              ScrollViewer.ScrollChanged="GridWorkbook_ScrollChanged"
                              RowHeaderWidth="45">
                        <DataGrid.RowHeaderStyle>
                            <Style TargetType="DataGridRowHeader">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridRowHeader">
                                            <Border Background="#E4E4E4" BorderBrush="#C8C8C8" BorderThickness="0,0,1,1">
                                                <TextBlock Text="{Binding RowNumber}" Foreground="#222222" FontWeight="SemiBold"
                                                           FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowHeaderStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#E4E4E4"/>
                                <Setter Property="Foreground" Value="#222222"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="BorderBrush" Value="#C8C8C8"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <!-- Cells own the border-drawing (grid lines above); giving DataGridCell
                             its own border/padding too caused doubled, misaligned lines. -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                                    BorderBrush="{DynamicResource Accent}" BorderThickness="0">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#4DBEE7CB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                    </DataGrid>

                    <Canvas x:Name="ImageOverlay" IsHitTestVisible="False" ClipToBounds="True"/>
                </Grid>
            </Border>

            <!-- Sheet tabs: horizontally scrollable so extra sheets never run off-screen -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1,0,1,1" Background="{DynamicResource BgPanel}" CornerRadius="0,0,6,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{DynamicResource Win11Button}" Padding="6,4" Margin="4,4,0,4"
                            Content="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="BtnScrollTabsLeft_Click"/>

                    <ScrollViewer x:Name="TabsScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="TabsScroll_PreviewMouseWheel">
                        <ItemsControl x:Name="SheetTabs" Margin="4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Column="2" Style="{DynamicResource Win11Button}" Padding="6,4" Margin="0,4,4,4"
                            Content="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="BtnScrollTabsRight_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
